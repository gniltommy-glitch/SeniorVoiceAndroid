# Server-only credentials. FREE_ONLY skips direct Gemini/DeepSeek paid APIs.
PROVIDER_ORDER=opengateway,openrouter,groq,gemini,deepseek
FREE_ONLY=1
OPENGATEWAY_API_KEY=
OPENGATEWAY_MODEL=qwen/qwen3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Server only. Never paste provider keys into Android or commit real values.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
DEVICE_TOKENS_JSON={"phone-1":"replace-with-a-random-token-at-least-24-characters"}
REQUESTS_PER_MINUTE=10
BIND_HOST=127.0.0.1
PORT=8787

# Optional home server behind the same authenticated proxy
LOCAL_ENABLED=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional: gemini,deepseek; leave empty to preserve free-only use.
METERED_FALLBACKS=
